# Baileys WhatsApp gateway
#
# Baileys is an UNOFFICIAL WhatsApp Web protocol client, not the Meta WhatsApp
# Business Cloud API. Use a spare number.

# Shared secret between the gateway and the backend, both directions.
# The gateway REFUSES TO START without it. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_GATEWAY_SECRET=

# Where this gateway listens for POST /send from the backend.
GATEWAY_PORT=8100

# Where the backend listens for inbound messages.
BACKEND_URL=http://localhost:8000
BACKEND_INBOUND_PATH=/webhook/inbound

# Session credentials. Gitignored. Delete this directory to force a fresh QR.
AUTH_DIR=auth

# How long to wait on the backend, and how many extra attempts to make.
BACKEND_TIMEOUT_MS=30000
BACKEND_RETRIES=4

# How many WhatsApp message ids to remember for deduplication.
DEDUPE_SIZE=2000
