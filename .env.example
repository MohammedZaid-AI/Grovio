# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# LLM  (one of these is required)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Credential encryption  (REQUIRED to link provider accounts — fails closed)
# ---------------------------------------------------------------------------
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store this OUTSIDE the database it protects. Rotating it invalidates every
# existing link (users simply reconnect).
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Public URL  (REQUIRED for OAuth callbacks; must be https in production)
# ---------------------------------------------------------------------------
# The provider redirects here after a user authorises us. This exact URL must be
# whitelisted by the provider — see FEASIBILITY.md.
#   {PUBLIC_BASE_URL}/link/{provider}/callback
PUBLIC_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# WhatsApp transport
# ---------------------------------------------------------------------------
# cloud  WhatsApp Business Cloud API (Meta official). PRODUCTION. Default.
# local  personal WhatsApp Web session. DEVELOPMENT ONLY — unofficial, the
#        number can be banned, and there is no webhook signature to verify.
#        Needs: pip install neonize "qrcode[pil]"   See CLAUDE.md.
WHATSAPP_PROVIDER=cloud

# Where the local session is stored (WHATSAPP_PROVIDER=local). Gitignored.
# WHATSAPP_SESSION_DIR=.data/whatsapp-session

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API — required when WHATSAPP_PROVIDER=cloud
# ---------------------------------------------------------------------------
# Business Manager -> WhatsApp -> API Setup.
# System-user token. Temporary tokens expire in 24h; issue a permanent one.
WHATSAPP_ACCESS_TOKEN=
# The SENDER's id, not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=
# App Settings -> Basic -> App Secret. Verifies X-Hub-Signature-256.
# FAILS CLOSED: unset means every webhook is rejected.
WHATSAPP_APP_SECRET=
# Any string you choose; echoed back during webhook subscription.
# FAILS CLOSED: unset means verification always fails.
WHATSAPP_VERIFY_TOKEN=
# Optional, for logs and tooling.
# WHATSAPP_APP_ID=
# Optional; defaults to the version in whatsapp/cloud_api.py.
# META_API_VERSION=v23.0

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
# Optional. Swiggy issues client ids by dynamic registration, so normally you
# need neither of these.
# SWIGGY_OAUTH_CLIENT_ID=
# SWIGGY_OAUTH_CLIENT_SECRET=

# Endpoint overrides — a last resort. Endpoints are DISCOVERED first (RFC
# 8414/9728), and the provider's documented endpoints are used if discovery
# finds nothing. Set BOTH of these only to pin something different; they beat
# discovery and skip the network entirely. See OAUTH.md.
# SWIGGY_OAUTH_AUTHORIZE_URL=https://mcp.swiggy.com/auth/authorize
# SWIGGY_OAUTH_TOKEN_URL=https://mcp.swiggy.com/auth/token

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
DATABASE_PATH=database/orders.db
# Comma-separated allowlist. Set during private beta to restrict who can order.
# AUTHORIZED_PHONES=
# Logs full message content. Leave off outside local debugging — this is PII.
DEBUG=
