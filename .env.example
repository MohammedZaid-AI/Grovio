# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# LLM  (one of these is required)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Credential encryption  (REQUIRED to link provider accounts — fails closed)
# ---------------------------------------------------------------------------
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store this OUTSIDE the database it protects. Rotating it invalidates every
# existing link (users simply reconnect).
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Public URL  (REQUIRED for OAuth callbacks; must be https in production)
# ---------------------------------------------------------------------------
# The provider redirects here after a user authorises us. This exact URL must be
# whitelisted by the provider — see FEASIBILITY.md.
#   {PUBLIC_BASE_URL}/link/{provider}/callback
PUBLIC_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# WhatsApp transport - the Baileys gateway
# ---------------------------------------------------------------------------
# Messages arrive from, and are sent through, whatsapp-gateway/ (Node).
# Start it with `npm start` in that directory and scan the QR once.
#
# WARNING: Baileys is an UNOFFICIAL WhatsApp Web protocol client, NOT the Meta
# WhatsApp Business Cloud API. It is used deliberately for this prototype.
# WhatsApp can ban the number - use a spare one, never a number tied to a
# business account.

# The shared secret, BOTH directions. It must match WHATSAPP_GATEWAY_SECRET in
# whatsapp-gateway/.env exactly.
#   FAILS CLOSED: unset means every inbound message is rejected AND every
#   outgoing send fails, so the product goes silent.
# Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
WHATSAPP_GATEWAY_SECRET=

# Where the gateway listens for our sends.
WHATSAPP_GATEWAY_URL=http://localhost:8100
# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
# Optional. Swiggy issues client ids by dynamic registration, so normally you
# need neither of these.
# SWIGGY_OAUTH_CLIENT_ID=
# SWIGGY_OAUTH_CLIENT_SECRET=

# Endpoint overrides — a last resort. Endpoints are DISCOVERED first (RFC
# 8414/9728), and the provider's documented endpoints are used if discovery
# finds nothing. Set BOTH of these only to pin something different; they beat
# discovery and skip the network entirely. See OAUTH.md.
# SWIGGY_OAUTH_AUTHORIZE_URL=https://mcp.swiggy.com/auth/authorize
# SWIGGY_OAUTH_TOKEN_URL=https://mcp.swiggy.com/auth/token

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
DATABASE_PATH=database/orders.db
# Comma-separated allowlist. Set during private beta to restrict who can order.
# AUTHORIZED_PHONES=
# Logs full message content. Leave off outside local debugging — this is PII.
DEBUG=
